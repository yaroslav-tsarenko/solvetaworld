# ============================================================
# Solvetaworld — environment template
# Copy to .env (or set these in your host, e.g. Vercel) and fill in real values.
# Never commit real secrets — .env and .env*.local are gitignored.
# ============================================================

# ============================================================
# Database — PostgreSQL (Neon in production, Prisma Postgres locally)
# ============================================================
# App runtime + Prisma CLI connection (pooled).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (non-pooled) connection — used by migrations and seed.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ============================================================
# Auth
# ============================================================
# Random 32+ byte secret. Generate: openssl rand -base64 32
JWT_SECRET="change-this-to-a-random-secret-in-production"

# ============================================================
# App Config
# ============================================================
# Public base URL, no trailing slash. Used in emails, SEO, sitemap.
NEXT_PUBLIC_SITE_URL="https://www.solvetaworld.com"

# ============================================================
# Cloudflare R2 — image CDN storage
# ============================================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# ============================================================
# Social Media
# ============================================================
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/your-handle/"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/company/your-company/"

# ============================================================
# SMTP — transactional emails (welcome, order confirmation,
# invoice, shipping, password reset, contact form)
# Provider: Spacemail. Host mail.spacemail.com, port 587 (STARTTLS)
# or 465 (implicit TLS). Username/password are the mailbox credentials.
# ============================================================
SMTP_HOST="mail.spacemail.com"
SMTP_PORT="587"
# "true" only for port 465 (implicit TLS); leave "false" for 587 (STARTTLS).
SMTP_SECURE="false"
SMTP_USER="info@solvetaworld.com"
SMTP_PASSWORD="your-mailbox-password"
# From address must belong to the authenticated mailbox's domain.
SMTP_FROM="Solvetaworld <info@solvetaworld.com>"
# Where contact-form submissions land and where customers reply.
SMTP_REPLY_TO="support@solvetaworld.com"

# ============================================================
# OpenAI — content/AI features
# ============================================================
OPENAI_API_KEY="sk-..."

# ============================================================
# PayNT / SetoPay / OPPWA (Copy & Pay) — payments
# Test sandbox: https://eu-test.oppwa.com
# Production:   https://eu-prod.oppwa.com
# ============================================================
PAYNT_BASE_URL="https://eu-test.oppwa.com"
PAYNT_ENTITY_ID="8ac9a4c9a0ce496501a10b62873b1817"
# User API Bearer Token (ASCII latin letters & digits only, no Cyrillic):
PAYNT_BEARER_TOKEN="your-paynt-bearer-token"
PAYNT_WEBHOOK_SECRET=""

# Legacy Pay By Link (OPPWA) — fallback support
PAYBYLINK_BASE_URL="https://eu-test.oppwa.com"
PAYBYLINK_ENTITY_ID="8ac9a4c9a0ce496501a10b62873b1817"
PAYBYLINK_AUTH_TOKEN="your-bearer-token"

